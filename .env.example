# AI Workbench Database Configuration
# Use a PostgreSQL instance with the pgvector extension installed.

# Option 1: Connection URL (Recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_workbench

# Option 2: Individual Parameters
DATABASE_NAME=ai_workbench
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here
DATABASE_HOST=localhost
DATABASE_PORT=5432
